# ENS English · Supabase local only
# Copy to .env.local after `supabase start` and obtain ANON_KEY with:
#   supabase status -o env
# Never expose SERVICE_ROLE_KEY in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<LOCAL_ANON_KEY_FROM_SUPABASE_STATUS>
NEXT_PUBLIC_ENS_ROUTE_CODE=A1-V3
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_COMMIT_SHA=local
